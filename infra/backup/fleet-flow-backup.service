[Unit]
Description=Fleet-Flow encrypted off-site database backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/fleet-flow/backup.env
ExecStart=/usr/bin/python3 /opt/fleet-flow/backup/backup.py backup
StateDirectory=fleet-flow-backup
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
TimeoutStartSec=2h
