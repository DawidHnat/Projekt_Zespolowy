# /etc/fleet-flow/backup.env, root:root, mode 0600. Nigdy w Git.
# Repozytorium u INNEGO dostawcy / na innym koncie niż VPS.
RESTIC_REPOSITORY=s3:https://UZUPELNIJ/bucket/fleet-flow
RESTIC_PASSWORD_FILE=/etc/fleet-flow/restic-password
AWS_ACCESS_KEY_ID=UZUPELNIJ_POZA_REPO
AWS_SECRET_ACCESS_KEY=UZUPELNIJ_POZA_REPO
FLEET_FLOW_BASE=/opt/fleet-flow
FLEET_FLOW_BACKUP_STATE=/var/lib/fleet-flow-backup
