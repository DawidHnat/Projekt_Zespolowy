# Szablon sekretu DEV_RUNTIME_ENV. Nie zapisuj rzeczywistych wartości w Git.
# Stałe hasło bazy wygeneruj raz poza repo; użyj znaków szesnastkowych,
# by zachować ten sam zapis w POSTGRES_PASSWORD i DATABASE_URL.
APP_DOMAIN=fleet-flow.pl
POSTGRES_DB=fleet_flow
POSTGRES_USER=fleet_flow
POSTGRES_PASSWORD=UZUPELNIJ_POZA_REPO
DATABASE_URL=postgresql+psycopg://fleet_flow:UZUPELNIJ_POZA_REPO@database:5432/fleet_flow
COOKIE_SECURE=true
CORS_ORIGINS=https://fleet-flow.pl
SYNC_ENABLED=false
# Opcjonalne WEBFLEET i SMTP dopiero w osobnym uzgodnionym uruchomieniu integracji.
