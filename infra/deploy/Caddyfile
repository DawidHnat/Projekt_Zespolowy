{
    auto_https disable_redirects
}

# Nazwane hosty przechodzą na kanoniczną domenę; zachowujemy ścieżkę i query.
# APP_DOMAIN jest docelowym fleet-flow.pl, aliasy nie hostują aplikacji.
http://{$APP_DOMAIN}, http://www.fleet-flow.pl, http://vps-9171bf52.vps.ovh.net {
    redir https://{$APP_DOMAIN}{uri} 308
}

https://www.fleet-flow.pl, https://vps-9171bf52.vps.ovh.net {
    redir https://{$APP_DOMAIN}{uri} 308
}

# HTTP po IP nadal udostępnia stronę wersji wymaganą w zadaniu kursowym.
# Nie udostępniamy tutaj formularza logowania, API ani danych floty.
http:// {
    header Cache-Control "no-store"
    @home path /
    handle @home {
        root * /srv/frontend
        rewrite * /status.html
        file_server
    }
    handle {
        respond "Otwórz aplikację przez HTTPS." 404
    }
}

{$APP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
