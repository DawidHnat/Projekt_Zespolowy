# Przykład — wyłącznie lokalny .env zawiera prawdziwe dane.
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_API_KEY=
WEBFLEET_TIMEOUT_SECONDS=20

# OVH Zimbra Starter. Test smtp wykonuje LOGIN i NOOP, bez wysłania wiadomości.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USERNAME=kontakt@fleet-flow.pl
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
