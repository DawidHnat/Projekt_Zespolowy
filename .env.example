# LOCAL development only. scripts/bootstrap.py fills the local database password.
POSTGRES_DB=fleet_flow
POSTGRES_USER=fleet_flow
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://fleet_flow:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/fleet_flow
DATA_SOURCE=demo
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Backend only. Change DATA_SOURCE to webfleet and fill these locally before sync.
WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_API_KEY=
WEBFLEET_TIMEOUT_SECONDS=15

# This map token is meant for browsers; restrict it to the intended domains.
# Never name backend credentials VITE_*. Vite exposes those variables to browsers.
VITE_MAPBOX_TOKEN=
# API_PROXY_TARGET is read by the Vite server, never by browser application code.
API_PROXY_TARGET=http://127.0.0.1:8000
