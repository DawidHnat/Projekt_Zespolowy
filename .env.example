# Przykład — wyłącznie lokalny .env zawiera prawdziwe dane.
POSTGRES_DB=fleet_flow
POSTGRES_USER=fleet_flow
POSTGRES_PASSWORD=
# URL-encode znaki specjalne loginu/hasła w DATABASE_URL.
DATABASE_URL=postgresql+psycopg://fleet_flow:UZUPELNIJ@127.0.0.1:5432/fleet_flow
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Dla zdalnego HTTPS ustaw true. HTTP dopuszczamy tylko na localhost.
COOKIE_SECURE=false
SYNC_ENABLED=false
VITE_MAPBOX_TOKEN=

WEBFLEET_ACCOUNT=
WEBFLEET_USERNAME=
WEBFLEET_PASSWORD=
WEBFLEET_API_KEY=
WEBFLEET_TIMEOUT_SECONDS=20

# OVH Zimbra Starter. Test smtp wykonuje LOGIN i NOOP, bez wysłania wiadomości.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=465
SMTP_USERNAME=kontakt@fleet-flow.pl
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20
