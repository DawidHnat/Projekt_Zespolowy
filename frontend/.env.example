# Ustaw te wartości w .env GŁÓWNEGO katalogu projektu (Vite używa envDir '..').
# Publiczny token Mapbox. Zostanie widoczny w przeglądarce; ogranicz jego uprawnienia i URL-e.
VITE_MAPBOX_TOKEN=
# Używany wyłącznie przez serwer Vite. Sekrety WEBFLEET w głównym .env czyta backend.
API_PROXY_TARGET=http://127.0.0.1:8000
